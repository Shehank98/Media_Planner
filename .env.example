# ---------------------------------------------------------------------------
# Database (Railway sets DATABASE_URL automatically when Postgres is attached)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/media_planner
# Railway's managed Postgres uses a self-signed cert. Set true there, false for
# a local dev database without TLS.
PGSSL=false

# Restricted, SELECT-only role for the ad-hoc Gemini SQL feature. Create it with
# db/restricted_role.sql and point this at that role. If left blank the app
# still forces every ad-hoc query into a read-only, timeout-bound transaction.
READONLY_DATABASE_URL=
READONLY_ROW_LIMIT=500
READONLY_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Gemini (narrative + ad-hoc questions only; all numbers computed in Python)
# https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.3

# ---------------------------------------------------------------------------
# Uploads / business defaults
# ---------------------------------------------------------------------------
# Adex / media-watch exports can be large (100k+ rows, tens of MB). Set this
# high enough for your biggest sheet. On Railway, update the MAX_UPLOAD_MB
# service variable too (an old value there overrides this default).
MAX_UPLOAD_MB=200
# Where staged upload payloads live while awaiting review. Use an ephemeral
# path on Railway (files are re-uploadable).
DATA_DIR=./var
# Default prime-time window (also adjustable at runtime under Settings).
PRIME_START=18:00
PRIME_END=22:00

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8000
