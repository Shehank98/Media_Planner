# ---------------------------------------------------------------------------
# Database (Railway provides DATABASE_URL automatically when you attach Postgres)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://user:pass@localhost:5432/media_planner
# Railway's managed Postgres terminates TLS with a self-signed cert. Leave as
# "true" there; set "false" for a local dev database with no TLS.
PGSSL=false

# ---------------------------------------------------------------------------
# LLM provider - the ONLY line you change to move from Phase 1 to Phase 2
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini

# Phase 1: Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.3

# Phase 2: Ollama, reached over a Cloudflare Tunnel from Railway
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.3
# CPU-only inference is slow; give it room before timing out (ms).
OLLAMA_TIMEOUT_MS=600000

# ---------------------------------------------------------------------------
# Google Drive sync (adex data)
# ---------------------------------------------------------------------------
# Drive auth. Two options; OAuth is the one that works without paying.
#
# OAuth as a real user (recommended). A service account has no Drive storage of
# its own - it can only write into a Shared Drive, which needs a paid Workspace.
# OAuth authenticates as you and uses your own 15GB. Generate these with the
# Google OAuth Playground or the Drive quickstart (scope: drive.file).
# These can also be set at runtime under the Settings tab instead of here.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Service account (fallback). The Drive folder must be shared with the account's
# client_email. Archiving with a service account needs a Shared Drive.
GDRIVE_FOLDER_ID=
# Either point at a key file on disk...
GOOGLE_APPLICATION_CREDENTIALS=
# ...or paste the service-account JSON directly.
# Base64 is also accepted, which avoids newline mangling in the dashboard.
GDRIVE_SERVICE_ACCOUNT_JSON=

# Cron expression for the periodic pull. Default: every 4 hours.
SYNC_CRON=0 */4 * * *
# Set false to disable the scheduler and rely on POST /api/sync/now only.
SYNC_ENABLED=true

# ---------------------------------------------------------------------------
# Report worker
# ---------------------------------------------------------------------------
PYTHON_BIN=python3
REPORT_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
# Max upload size for TVR/channel workbooks and brief PDFs, in megabytes.
MAX_UPLOAD_MB=25
